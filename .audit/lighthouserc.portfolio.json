{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter portfolio preview",
      "startServerReadyPattern": "Local:",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/about",
        "http://localhost:4173/resume",
        "http://localhost:4173/projects",
        "http://localhost:4173/contact"
      ],
      "numberOfRuns": 1
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".audit/tools/lhci-portfolio"
    }
  }
}
