{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter blog preview",
      "startServerReadyPattern": "Local:",
      "url": [
        "http://localhost:4173/blog",
        "http://localhost:4173/blog/hello-world",
        "http://localhost:4173/adr"
      ],
      "numberOfRuns": 1
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".audit/tools/lhci-blog"
    }
  }
}
